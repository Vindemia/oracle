# Database (PostgreSQL)
DB_PASSWORD=changeme_strong_password

# JWT — générer avec: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=changeme_random_64_chars_minimum
JWT_REFRESH_SECRET=changeme_different_random_64_chars_minimum

# Server
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Notifications push (générer avec: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@example.com

# Échos (retours utilisateurs → issues GitHub). Absents = warning au boot,
# les échos restent en base sans perte (PAT fine-grained, scope issues:write).
GITHUB_FEEDBACK_TOKEN=
GITHUB_FEEDBACK_REPO=owner/repo

# Email (récupération de mot de passe) — absentes : lien de reset loggé en
# console en développement, envoi silencieusement ignoré en production.
SMTP_URL=
MAIL_FROM=

# Client (Vite — préfixe VITE_ obligatoire pour exposition au navigateur)
VITE_API_URL=http://localhost:3001/api

# Docker (production uniquement)
DOCKER_REGISTRY=ghcr.io/your-username
TAG=latest

# Sauvegardes Postgres — copie hors machine (production uniquement, optionnel)
# Remote rclone (ex: s3:mon-bucket/oracle) — absent = copie hors machine désactivée
# (les dumps quotidiens locaux avec rotation restent actifs dans tous les cas)
RCLONE_REMOTE=
RCLONE_KEEP=30

# Base URL complète PostgreSQL (construite depuis les variables ci-dessus par docker-compose)
# En développement hors Docker, renseigner directement :
DATABASE_URL=postgresql://oracle:changeme_strong_password@localhost:5432/oracle
