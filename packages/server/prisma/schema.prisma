generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  password      String
  displayName   String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  tasks         Task[]
  tags          Tag[]
  refreshTokens RefreshToken[]
  feedbacks     Feedback[]
  passwordResetTokens PasswordResetToken[]

  // Préférences de notifications push (présages)
  remindersEnabled      Boolean            @default(true)
  reminderLeadMinutes   Int                @default(15)
  dailySummaryEnabled   Boolean            @default(true)
  dailySummaryHour      Int                @default(8)
  staleRemindersEnabled Boolean            @default(false)
  staleDays             Int                @default(7)
  timezone              String             @default("Europe/Paris")
  lastDailySummaryOn    String?
  lastStaleRemindersOn  String?
  pushSubscriptions     PushSubscription[]

  // Token opaque d'authentification du flux iCal (les clients agenda ne portent pas de JWT)
  calendarFeedToken String? @unique
}

model PushSubscription {
  id        String   @id @default(uuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Task {
  id          String     @id @default(uuid())
  title       String
  urgent      Boolean    @default(false)
  important   Boolean    @default(false)
  quadrant    Quadrant
  status      TaskStatus @default(ACTIVE)
  notes       String?
  plannedFor  DateTime?
  // Date d'envoi du rappel d'échéance — évite les présages en double
  reminderSentAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  completedAt DateTime?
  position    Int        @default(0)
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tags        TaskTag[]

  @@index([userId, status])
  @@index([userId, quadrant])
  @@index([userId, quadrant, position])
}

model Tag {
  id        String    @id @default(uuid())
  name      String
  icon      String
  color     String
  isDefault Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks     TaskTag[]

  @@unique([userId, name])
}

model TaskTag {
  taskId String
  tagId  String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

model Feedback {
  id             String       @id @default(uuid())
  kind           FeedbackKind
  message        String
  // Métadonnées jointes automatiquement (route, userAgent, version app) — jamais d'email.
  context        Json         @default("{}")
  githubIssueUrl String?
  // null tant que la synchronisation GitHub n'a pas réussi — sert de claim atomique pour le tick.
  syncedAt       DateTime?
  createdAt      DateTime     @default(now())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([syncedAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum Quadrant {
  FIRE
  STARS
  WIND
  MIST
}

enum TaskStatus {
  ACTIVE
  DONE
  ELIMINATED
}

enum FeedbackKind {
  PRAISE
  IDEA
  BUG
}
